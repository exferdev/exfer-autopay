# ── Wallets ───────────────────────────────────────────────────────────────────
# Multi-wallet config file (takes priority over single-wallet vars below)
WALLETS_FILE=./wallets.json

# Single-wallet fallback (used when WALLETS_FILE is not set)
# MNEMONIC="word1 word2 word3 ... word24"
# KEY_FILE_PATH=/etc/exfer-autopay/wallet.key
# KEY_FILE_PASS=your-passphrase

# ── Security ──────────────────────────────────────────────────────────────────
# Random string — keep secret, used in Authorization: Bearer <key>
API_KEY=change-me-to-a-random-secret

# Comma-separated IPs allowed to call the API (leave empty to allow all)
# ALLOWED_IPS=127.0.0.1,10.0.0.5

# ── Network ───────────────────────────────────────────────────────────────────
RPC_URL=https://rpc.exfer.dev
API_URL=https://api.exfer.dev
PORT=3888

# ── Behaviour ─────────────────────────────────────────────────────────────────
MAX_BATCH_SIZE=200          # max recipients per batch transaction
CONFIRM_TIMEOUT_SEC=300     # seconds before an in-flight tx is considered failed
MAX_RETRIES=3               # max retry attempts per batch before marking failed
POLL_INTERVAL_MS=3000       # how often to check for confirmation

# ── Paths ─────────────────────────────────────────────────────────────────────
DB_PATH=./data/queue.db
